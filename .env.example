GROQ_API_KEY=

# Optional: override the default Groq model (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=

# Supabase project (server-only). Never put the service-role / secret key here.
# Copy the Project URL and the anon/publishable key from Project Settings -> API.
#
# After creating the project:
#   1. Run these files, in order, in Dashboard -> SQL Editor
#      (or `supabase db push` if you use the CLI):
#        supabase/migrations/20261007000000_phase6_auth_and_decks.sql
#        supabase/migrations/20261007000001_phase7_mastery.sql
#        supabase/migrations/20261007000002_add_cards_to_deck.sql
#        supabase/migrations/20261007000003_same_day_learning.sql
#   2. Auth -> URL configuration
#        Site URL:        http://localhost:3000
#        Redirect URLs:   http://localhost:3000/auth/confirm
#   3. Optional for a classroom (students sign in immediately):
#        Auth -> Providers -> Email -> turn off "Confirm email"
SUPABASE_URL=
SUPABASE_ANON_KEY=
