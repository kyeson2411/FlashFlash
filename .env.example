GROQ_API_KEY=

# Optional: override the default Groq model (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=

# Supabase project (server-only). Never put the service-role / secret key here.
# Copy the Project URL and the anon/publishable key from Project Settings -> API.
#
# After creating the project:
#   1. Run these files, in order, in Dashboard -> SQL Editor
#      (or `supabase db push` if you use the CLI):
#        supabase/migrations/20261007000000_phase6_auth_and_decks.sql
#        supabase/migrations/20261007000001_phase7_mastery.sql
#        supabase/migrations/20261007000002_add_cards_to_deck.sql
#        supabase/migrations/20261007000003_same_day_learning.sql
#   2. Auth -> URL configuration
#        Site URL:        http://localhost:3000
#        Redirect URLs:   http://localhost:3000/auth/confirm
#   3. Optional for a classroom (students sign in immediately):
#        Auth -> Providers -> Email -> turn off "Confirm email"
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Present offline (no internet after the first setup)
# Install Docker Desktop and the Supabase CLI, start Docker, then run `supabase start`.
# Point this file's copy (.env.local) at the laptop database instead of the hosted one:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_ANON_KEY=<anon key from `supabase status`>
# The usual local anon key is:
#   eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Then `npm run present` starts the local database and the app at http://localhost:3000.
# Teacher: teacher@autoflash.test / Teacher1flash
# Student: student@autoflash.test / Student1flash
# Making new cards still needs the internet (Groq). Study, classes, and quizzes do not.
